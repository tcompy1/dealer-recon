# Copy to .env.production on the VPS and replace every CHANGE_ME value.
# Do not commit .env.production.

POSTGRES_DB=dealer_recon
POSTGRES_USER=dealer_recon
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL

NODE_ENV=production
DATABASE_URL=postgresql://dealer_recon:CHANGE_ME_GENERATE_WITH_OPENSSL@db:5432/dealer_recon
BACKEND_CORS_ORIGINS=https://dealer-recon.example.com
DEFAULT_DEALERSHIP_ID=1
SESSION_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# Same-origin v1 deployment: frontend calls backend through the HTTPS reverse proxy.
VITE_API_BASE_URL=https://dealer-recon.example.com
