POSTGRES_DB=dealer_recon
POSTGRES_USER=dealer_recon
POSTGRES_PASSWORD=dealer_recon

# Set NODE_ENV to "development" or "test" for local work. Any other value
# (e.g. "staging", "production") is treated as a deployed environment and the
# server will refuse to start unless DATABASE_URL, BACKEND_CORS_ORIGINS, and
# SESSION_SECRET are all set to non-default values.
NODE_ENV=development
DATABASE_URL=postgresql://dealer_recon:dealer_recon@db:5432/dealer_recon

# Comma-separated list of allowed browser origins for CORS. Required outside
# of development/test environments. In dev, defaults to http://localhost:5173
# if unset. Never use a wildcard with credentialed requests in production.
BACKEND_CORS_ORIGINS=http://localhost:5173

UPLOAD_STORAGE_PATH=/app/storage/uploads
DEFAULT_DEALERSHIP_ID=1

# Session signing secret. Must be at least 32 characters. The value shown
# below is ONLY allowed in NODE_ENV=development/test; the server refuses to
# start in any other environment if SESSION_SECRET is missing or equal to
# this placeholder. Generate a real secret per deployment, e.g.:
#   openssl rand -hex 32
# and store it via your deployment secret manager (do not commit real values).
SESSION_SECRET=local-dev-session-secret-change-before-production

VITE_API_BASE_URL=http://localhost:8000

# Parser debug logging. Off by default. Set PARSER_DEBUG=true (only in
# non-production environments) to print BOA/Dealertrack parser row-count
# summaries and a small sample of accepted rows to stderr. Never enable
# in production: sample rows contain raw client data (VINs, stock numbers,
# amounts) and must not be written to shared logs.
# PARSER_DEBUG=false
